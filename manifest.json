{
  "manifest_version": 3,
  "name": "BIPU Wallet",
  "version": "0.2.0",
  "description": "Progressive wallet for BIPU: BIPU attestation identity + connect your Phantom for funds.",
  "action": {
    "default_popup": "popup.html",
    "default_title": "BIPU Wallet"
  },
  "background": { "service_worker": "background.js" },
  "permissions": ["storage", "activeTab", "scripting"],
  "host_permissions": [
    "https://api.mainnet-beta.solana.com/",
    "https://lite-api.jup.ag/*",
    "https://api.jup.ag/*",
    "https://rendezvous.metaspn.network/*"
  ]
}
